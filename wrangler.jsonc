{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jb-front",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-17",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 라우트가 서버에 없는 SPA 라서, 못 찾은 경로는 index.html 로 떨어뜨린다.
    "not_found_handling": "single-page-application",
    // ⚠️ 이게 핵심이다. 기본값은 에셋을 먼저 찾아서, /api/* 가 위의 SPA fallback 에
    //    걸려 index.html 이 나간다(바로 그게 배포에서 API 가 죽던 원인).
    //    Worker 를 먼저 태워야 /api/* 를 가로챌 수 있다.
    "run_worker_first": true
  },

  "vars": {
    /*
     * 백엔드. **IP 가 아니라 호스트명이어야 한다.**
     *
     * Workers 의 fetch 는 목적지가 IP 리터럴이면 요청을 보내지 않고 Cloudflare 에러
     * 페이지(error code: 1003, "Direct IP access not allowed")를 돌려준다.
     * worker/index.js 는 응답을 그대로 흘려보내므로 /api/* 가 전부 403 이 된다.
     *
     * 실측(2026-09-17): 이 값이 http://43.203.149.41 일 때
     *   https://jb-front.kaameo12.workers.dev/api/me → 403 "error code: 1003"
     *   같은 순간 http://43.203.149.41/api/me       → 백엔드의 401 JSON
     *
     * ⚠️ 로컬 `wrangler dev` 는 일반 네트워크라 IP 로도 통과한다. 그래서 이 차이는
     *    **배포한 뒤에야 드러난다** — 로컬 통과만으로 안심하면 안 된다.
     *
     * 아래는 AWS 가 인스턴스마다 공짜로 주는 퍼블릭 DNS 라 같은 서버로 resolve 된다.
     * 도메인 구매가 필요 없고 제3자 DNS 에 기대지도 않는다.
     */
    "API_ORIGIN": "http://ec2-43-203-149-41.ap-northeast-2.compute.amazonaws.com"
  }
}
