{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jb-front",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-17",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 라우트가 서버에 없는 SPA 라서, 못 찾은 경로는 index.html 로 떨어뜨린다.
    "not_found_handling": "single-page-application",
    // ⚠️ 이게 핵심이다. 기본값은 에셋을 먼저 찾아서, /api/* 가 위의 SPA fallback 에
    //    걸려 index.html 이 나간다(바로 그게 배포에서 API 가 죽던 원인).
    //    Worker 를 먼저 태워야 /api/* 를 가로챌 수 있다.
    "run_worker_first": true
  },

  "vars": {
    /*
     * 백엔드. **IP 가 아니라 호스트명이어야 한다.**
     *
     * Worker 의 fetch 는 IP 리터럴을 거부한다 — Cloudflare 가 "Direct IP Access Not
     * Allowed"(오류 1003)로 막는다. 로컬 `wrangler dev` 는 일반 네트워크라 통과해서
     * 이 차이가 배포 후에야 드러났다.
     *
     * ⚠️ nip.io 는 임시방편이다. `<ip>.nip.io` 를 그 IP 로 해석해 주는 제3자 DNS 라,
     *    그 서비스가 죽으면 우리 API 도 같이 죽는다. **백엔드에 도메인이 생기면
     *    즉시 그걸로 바꾼다**(docs/front-todo.md).
     */
    "API_ORIGIN": "http://43.203.149.41.nip.io"
  }
}
